# ModelDeck backend configuration
# Copy this file to .env and fill in your own values.
# Never commit a filled-in .env file.

# Listen address (default: 127.0.0.1:8787)
PORT=8787
HOST=127.0.0.1

# In production, set this to your public origin so media URLs are correct.
# PUBLIC_ORIGIN=https://your-domain.com

# Session token signing key — at least 16 characters, randomly generated.
# Example: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# fal.ai key — get it from https://fal.ai/dashboard/keys
# Almost every model runs through fal.ai.
FAL_KEY=your-fal-ai-key-here

# OpenAI key — needed only for Sora video generation
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here

# Enable to show uncensored / spicy models (hidden by default)
# ENABLE_SPICY_MODELS=1

# Where media and account data live (default: ./storage)
# STORAGE_DIR=./storage

# Comma-separated allowed origins for CORS
# CORS_ORIGINS=http://127.0.0.1:5173

# Ceiling on one generation job in milliseconds (default: 900000 = 15 min)
# JOB_TIMEOUT_MS=900000

# Credit price in USD (default: 0.004). This is your markup — the only number
# that sets your resale price per credit.
# CREDIT_PRICE_USD=0.004